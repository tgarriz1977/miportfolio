# Configuración del módulo de análisis.
# Copiar a .env y completar. .env está en .gitignore: la API key no debe
# entrar al repositorio.
#
#     cp .env.example .env
#
# Sin LLM_PROVIDER definido el dashboard funciona igual y el panel muestra
# noticias y balances; solo queda sin el resumen redactado.

# ── Gemini ────────────────────────────────────────────────────────────
# Key: https://aistudio.google.com/apikey
# Usa el endpoint compatible con OpenAI, por eso el provider es openai_compat.
#
# gemini-flash-latest es un alias que sigue al modelo flash vigente. Conviene
# sobre un nombre con número: Google retira modelos y un nombre fijo deja de
# funcionar sin aviso (gemini-2.0-flash y gemini-2.5-flash ya están retirados).
LLM_PROVIDER=openai_compat
LLM_MODEL=gemini-flash-latest
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=

# Para ver qué modelos habilita tu key:
#   curl -s -H "Authorization: Bearer $LLM_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/openai/models \
#     | grep -o '"id":"[^"]*"'
#
# Ojo: el listado incluye modelos retirados. Si uno falla, probalo con un
# request real antes de descartar el resto de la configuración.

# ── DeepSeek ──────────────────────────────────────────────────────────
# Key: https://platform.deepseek.com/api_keys
# También habla el protocolo de OpenAI, así que usa el mismo adaptador.
# Verificá los nombres de modelo con /models antes de asumirlos (ver arriba).
# LLM_PROVIDER=openai_compat
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-...

# ── Anthropic ─────────────────────────────────────────────────────────
# Key: https://console.anthropic.com/settings/keys
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
# LLM_API_KEY=sk-ant-...

# ── Modelo local (Ollama, LM Studio, vLLM) ────────────────────────────
# Sin credencial y sin costo por consulta. Desde el contenedor, el host se
# alcanza por host.docker.internal, no por localhost.
# LLM_PROVIDER=openai_compat
# LLM_MODEL=llama3
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# ── Caché ─────────────────────────────────────────────────────────────
# Horas que se reusa un análisis antes de volver a pedirlo.
INSIGHT_TTL_HOURS=6
